# This is an example environment file for WHIZ-MD Bot.
# Rename this file to .env in your project root and fill in the actual values.
# IMPORTANT: Do NOT commit your actual .env file with sensitive credentials to Git.

# WhatsApp Session ID (Required for the bot to connect)
# Obtain this by scanning the QR code through the bot's startup process OR from your session generation system.
# The variable name MUST start with WHIZMD_ and can be anything after that.
# Example: WHIZMD_MYSESSIONID="your_base64_session_string_here"
WHIZMD_SESSION_UNIQUEKEY="YOUR_SESSION_ID_STRING_HERE"

# Bot Owner Configuration (Recommended)
# Your WhatsApp number (e.g., 12345678900 - no '+' or other symbols, just numbers)
OWNER_NUMBER="254754783683"
# Your name or the desired owner name to be displayed in the bot's menu
OWNER_NAME="WHIZ"

# API Key for Remove.bg (Optional - only if you want to use the .removebg command)
# Get your API key from https://www.remove.bg/dashboard#api-key
REMOVE_BG_API_KEY=""

# Other potential future environment variables can be added here.
# Example:
# DATABASE_URL="your_database_connection_string"
# THIRD_PARTY_API_KEY="another_api_key"
# LOG_LEVEL="info"
