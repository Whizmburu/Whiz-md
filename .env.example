# WhatsApp Session Data (Base64 encoded JSON string)
# This will be checked by the bot. It must start with WHIZMD_
# Example: WHIZMD_eyJhYmN....xyz=
WHIZMD_SESSION_DATA=""

# Owner number (e.g., 2547xxxxxxxx@c.us)
OWNER_NUMBER="254754783683@c.us"

# Bot Prefix
BOT_PREFIX="."

# API Keys (leave blank if not used initially)
OPENAI_API_KEY=""
# Add other API keys here as needed
# EXAMPLE_API_KEY=""

# For .shazam command (ACRCloud as an example)
# ACRCLOUD_HOST=""
# ACRCLOUD_ACCESS_KEY=""
# ACRCLOUD_ACCESS_SECRET=""

# For .lyrics command (if using an API that needs a key)
# LYRICS_API_KEY=""

# For .removebg command
REMOVEBG_API_KEY=""

# For .weather command (OpenWeatherMap)
OPENWEATHERMAP_API_KEY=""

# For OpenAI API (DALL-E, ChatGPT - .image, .chatgpt commands)
OPENAI_API_KEY=""

# For .meme command (if using an API that needs a key, e.g. Imgflip)
# IMGFLIP_USERNAME=""
# IMGFLIP_PASSWORD=""

# For GIF commands (e.g., Giphy, Tenor - for hug, kiss, slap etc. if enhanced with GIFs)
# GIPHY_API_KEY=""
# TENOR_API_KEY=""
